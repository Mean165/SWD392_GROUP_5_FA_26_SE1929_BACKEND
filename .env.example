# Local speech inference. No speech-provider API keys are required.
STT_PROVIDER=local
TTS_PROVIDER=local
STT_MODE=streaming_only
LOCAL_INFERENCE_URL=http://127.0.0.1:8000
LOCAL_INFERENCE_TOKEN=generate-with-scripts/setup-inference.ps1
STT_ALLOWED_ORIGINS=http://localhost:5173
LOCAL_STT_MODEL=/models/stt/large-v3-turbo-ct2
LOCAL_STT_FALLBACK_MODEL=/models/stt/base
LOCAL_TTS_ENGINE=piper
LOCAL_TTS_VOICE_VI=/models/tts/vi_VN-vais1000-medium.onnx
LOCAL_TTS_VOICE_EN=/models/tts/en_US-lessac-medium.onnx
LOCAL_TTS_USE_CUDA=false
LOCAL_TTS_NORMALIZE=true
LOCAL_TTS_SPEED=1.0
LOCAL_TTS_CACHE_DIR=/models/tts-cache
LOCAL_TTS_CACHE_MAX_ENTRIES=256
LOCAL_TTS_MAX_TEXT_LENGTH=4000
LOCAL_TTS_PRONUNCIATION_LEXICON=/srv/inference/data/pronunciation_lexicon.json
LOCAL_STT_DEVICE=cuda
LOCAL_STT_COMPUTE_TYPE=int8_float16
LOCAL_STT_CPU_THREADS=8
LOCAL_STT_MAX_CONCURRENT=1
LOCAL_STT_PARTIAL_INTERVAL_MS=1000
LOCAL_STT_COMMIT_SILENCE_MS=700
LOCAL_STT_MAX_SEGMENT_S=28
LOCAL_STT_PROMPT_MAX_TOKENS=160
LOCAL_STT_PARTIAL_BEAM_SIZE=1
LOCAL_STT_FINAL_BEAM_SIZE=5
LOCAL_STT_PARTIAL_AGREEMENT_ROUNDS=2
LOCAL_STT_QUEUE_WAIT_MS=250
LOCAL_STT_CONFIDENCE_THRESHOLD=0.35
LOCAL_STT_NO_SPEECH_THRESHOLD=0.6
LOCAL_STT_LOGPROB_THRESHOLD=-1.0
LOCAL_STT_COMPRESSION_RATIO_THRESHOLD=2.4
LOCAL_REQUEST_TIMEOUT_S=180
AUDIO_RETENTION_DAYS=30
