FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    BIND_HOST=127.0.0.1 \
    PORT=8000 \
    MODELS_DIR=/models \
    HF_HOME=/models/hf-cache

RUN apt-get update && apt-get install -y --no-install-recommends python3.10 python3.10-venv python3-pip libgomp1 libsndfile1 ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3.10 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /srv/inference
COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.14.1+cpu \
    && python -m pip install --no-cache-dir -r /tmp/requirements.txt
COPY app ./app
COPY data ./data
EXPOSE 8000
CMD ["sh", "-c", "exec python -m uvicorn app.main:app --host \"$BIND_HOST\" --port \"$PORT\""]
