{
  "openapi": "3.1.0",
  "info": {"title": "AiViva Local Inference", "version": "1.0.0"},
  "servers": [{"url": "http://127.0.0.1:8000"}],
  "components": {"securitySchemes": {"InternalToken": {"type": "apiKey", "in": "header", "name": "X-Internal-Token"}}},
  "security": [{"InternalToken": []}],
  "paths": {
    "/health": {"get": {"responses": {"200": {"description": "STT/TTS readiness and local resource information"}, "401": {"description": "Invalid internal token"}}}},
    "/v1/models": {"get": {"responses": {"200": {"description": "Installed model inventory"}}}},
    "/v1/stt/transcribe": {"post": {"requestBody": {"required": true, "content": {"multipart/form-data": {"schema": {"type": "object", "required": ["audio", "language"], "properties": {"audio": {"type": "string", "format": "binary"}, "language": {"type": "string", "enum": ["vi", "en"]}, "hotwords": {"type": "string", "description": "JSON array of strings"}, "initial_prompt": {"type": "string"}, "mode": {"type": "string", "enum": ["final"]}}}}}}, "responses": {"200": {"description": "Raw/normalized local transcript, word timestamps, confidence and diagnostics"}, "401": {"description": "Invalid internal token"}, "413": {"description": "Audio limit exceeded"}, "429": {"description": "Queue full; Retry-After is set"}, "503": {"description": "Model is not ready"}}}},
    "/v1/tts/synthesize": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["text", "language", "voice"], "properties": {"text": {"type": "string"}, "language": {"type": "string", "enum": ["vi", "en"]}, "voice": {"type": "string"}, "speed": {"type": "number", "default": 1.0}, "format": {"type": "string", "enum": ["wav", "opus", "mp3"]}, "normalize": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "Audio bytes; X-Duration-Ms and X-Request-ID headers"}}}},
    "/v1/tts/stream": {"post": {"requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["text", "language", "voice"], "properties": {"text": {"type": "string"}, "language": {"type": "string", "enum": ["vi", "en"]}, "voice": {"type": "string"}, "speed": {"type": "number"}, "format": {"type": "string", "enum": ["pcm_s16le", "wav"]}, "normalize": {"type": "boolean"}}}}}}, "responses": {"200": {"description": "Newline-delimited JSON audio chunks and a done event"}}}},
    "/v1/stt/stream": {"get": {"description": "WebSocket upgrade. First client JSON is config; subsequent client messages are PCM16LE binary, commit/end JSON. Server events are ready/partial/committed/error/closed.", "parameters": [{"name": "language", "in": "query", "required": true, "schema": {"type": "string", "enum": ["vi", "en"]}}, {"name": "session_id", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "turn_id", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"101": {"description": "WebSocket protocol upgrade"}}}}
  }
}
